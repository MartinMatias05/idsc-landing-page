# Provisional dev port. Replace with the port assigned in docs/integration.md once the class assigns one.
PORT=3001
# Origin of the Vite dev server (CORS allow-list).
FRONTEND_URL=http://localhost:5173


# External CMS statistics API endpoints.
# Leave empty until the other groups provide their REST endpoints.
REGISTRAR_STATS_URL=
FACULTY_STATS_URL=

# External API request timeout and cache duration (milliseconds).
STATS_TIMEOUT_MS=3000
STATS_CACHE_MS=60000