# Landing Page API (see ../server/.env.example for the port)
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Destinations of the external systems. Leave empty until the owning group provides its final URL.
# An empty value makes the link render as "not available yet" instead of breaking the page.

# Existing News System. "Read update" and "View all notices" go here.
VITE_SYSTEM_NEWS_URL= https://voxtemplari.idsc.edu.ph/
# Optional: path of one article in the News System, only if its ids match the ids this API sends.
# Example: /articles/{id}   (leave empty to link every card to the News System landing URL)
VITE_SYSTEM_NEWS_ITEM_PATH=
# Existing IDSC Pulse System. Pulse cards go here.
VITE_SYSTEM_PULSE_URL=
VITE_SYSTEM_PULSE_ITEM_PATH=

# Other college systems
VITE_SYSTEM_LIBRARY_URL=
VITE_SYSTEM_STUDENT_PORTAL_URL=
VITE_SYSTEM_FINANCE_URL=
VITE_SYSTEM_FACULTY_URL=
VITE_SYSTEM_CLINIC_URL=
VITE_SYSTEM_REGISTRAR_URL=
VITE_SYSTEM_INVENTORY_URL=
