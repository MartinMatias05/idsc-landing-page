# Landing Page API (see ../server/.env.example for the port)
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Destinations of the other 7 systems. Leave empty until the owning group provides its final URL.
# An empty value makes the link render as "not available yet" instead of breaking the page.
VITE_SYSTEM_LIBRARY_URL=
VITE_SYSTEM_STUDENT_PORTAL_URL=
VITE_SYSTEM_FINANCE_URL=
VITE_SYSTEM_FACULTY_URL=
VITE_SYSTEM_CLINIC_URL=
VITE_SYSTEM_REGISTRAR_URL=
VITE_SYSTEM_INVENTORY_URL=
